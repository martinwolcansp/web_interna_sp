# Copiar como variables de entorno en Coolify (no subir valores reales al repo).

# NetSuite - OAuth 2.0 Client Credentials (M2M) + SuiteQL
# Integracion "SP Servicios internos M2M", rol SP WEB SERVICE INTEGRATION
# (mismas credenciales que indicadores-api).
NETSUITE_ACCOUNT_ID=7138551
NETSUITE_CLIENT_ID=
NETSUITE_CERT_ID=
NETSUITE_PRIVATE_KEY=
NETSUITE_PRIVATE_KEY_PATH=
NETSUITE_CONCURRENCIA=3

# GHL (todavia no se usan; mismo token que indicadores-api)
GHL_API_TOKEN=
GHL_LOCATION_ID=goympjLjeLIBzCFxsbFM

# Supabase de la web interna (misma anon key que js/supabase-client.js)
SUPABASE_URL=https://supabase.200.5.196.50.sslip.io
SUPABASE_ANON_KEY=

# Campos personalizados del cliente/establecimiento (confirmados con
# diagnostico_clientes.py el 30/10/2026; son los valores por defecto).
CAMPO_ESTADO_SERVICIO=custentity_3k_estado_establecimiento
CAMPO_NRO_CUENTA=custentity_3k_nro_establecimiento
CAMPO_FECHA_SUSPENSION=custentity_3k_fecha_suspension_bykom
CAMPO_MOTIVO_BAJA=custentity_ap_sp_motivo_de_baja
CAMPO_COMENTARIOS_MOTIVO=custentity_ap_sp_comentarios_baja
CAMPO_COMENTARIOS=comments
CAMPO_FECHA_INICIO_SUSPENSION=custentity_3k_fecha_inicio_suspension
CAMPO_DURACION_SUSPENSION=custentity_3k_duracion_suspension
CAMPO_TIPO_CLIENTE=custentity_3k_tipo_cuenta

# Segmentacion: que es un cliente y que estado cuenta como activo
CRITERIO_CLIENTES=c.searchstage = 'Cliente'
ESTADOS_ACTIVOS=ACTIVO

# Compras de la Segmentacion: unidades de negocio (nombre completo, separadas por coma)
COMPRAS_DESDE=2022-01-01
COMPRAS_UNIDADES=Alarmas : Nuevas,Alarmas : Comodato

# Bajas: condicion ademas de la fecha de suspension en el mes
CRITERIO_BAJAS=(UPPER({estado}) LIKE 'SUSPENSION%' OR UPPER({estado}) = 'BAJA')

# Opcionales
ZONA_HORARIA=America/Argentina/Buenos_Aires
MINUTOS_CORRIDA_COLGADA=30
CORRIDAS_A_CONSERVAR=40
ALLOWED_ORIGINS=https://portal.blogdns.com
