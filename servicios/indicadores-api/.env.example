# Copiar como variables de entorno en Coolify (no subir valores reales al repo).

# NetSuite - OAuth 2.0 Client Credentials (M2M) + SuiteQL
# Integracion "SP Servicios internos M2M", rol SP WEB SERVICE INTEGRATION.
# Se puede reutilizar el certificado de informe-mkt-api o subir uno propio.
NETSUITE_ACCOUNT_ID=7138551
NETSUITE_CLIENT_ID=
NETSUITE_CERT_ID=
# Clave privada PEM en una sola linea con \n, o usar NETSUITE_PRIVATE_KEY_PATH
NETSUITE_PRIVATE_KEY=
NETSUITE_PRIVATE_KEY_PATH=certificados/indicadores_private.pem

# GHL (mismo Private Integration Token que informe-mkt-api;
# scopes contacts.readonly, objects/schema.readonly y objects/record.readonly)
GHL_API_TOKEN=
GHL_LOCATION_ID=goympjLjeLIBzCFxsbFM
# Token de la integracion con scope objects/record.readonly (encuestas).
# Si queda vacio se usa GHL_API_TOKEN.
GHL_OBJETOS_API_TOKEN=
# Clave del objeto de encuestas (si queda vacia, se busca por nombre "encuesta")
GHL_OBJETO_ENCUESTAS=custom_objects.encuestas

# Supabase de la web interna (misma anon key que js/supabase-client.js)
SUPABASE_URL=https://supabase.200.5.196.50.sslip.io
SUPABASE_ANON_KEY=

# Corrida programada: usuario tecnico con permiso editar en indicadores-posventa
INDICADORES_BOT_EMAIL=
INDICADORES_BOT_PASSWORD=

# Posventa (mismos criterios que las busquedas 2560 y 2557 del Power BI)
POSVENTA_CASOS_DESDE=2026-01-02
POSVENTA_RELEV_DESDE=2025-05-02
POSVENTA_ASIGNADO_A=133

# Opcionales
ZONA_HORARIA=America/Argentina/Buenos_Aires
MINUTOS_CORRIDA_COLGADA=30
CORRIDAS_A_CONSERVAR=40
MINUTOS_ESPERA_EN_CURSO=20
ALLOWED_ORIGINS=https://portal.blogdns.com
