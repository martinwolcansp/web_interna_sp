<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_NuevosClientesVentaConsultiva" targetNamespace="http://sp-seguridad.com/procesos" exporter="bpmn-js" exporterVersion="18.30.1">
  <bpmn:category id="Category_Etapas">
    <bpmn:categoryValue id="CV_Grp_E1" value="Etapa 1 · Primer contacto" />
    <bpmn:categoryValue id="CV_Grp_E2" value="Etapa 2 · Concertación de la visita" />
    <bpmn:categoryValue id="CV_Grp_E3" value="Etapa 3 · Visita" />
    <bpmn:categoryValue id="CV_Grp_E4" value="Etapa 4 · Presupuesto" />
    <bpmn:categoryValue id="CV_Grp_E5" value="Etapa 5 · Seguimiento" />
  </bpmn:category>
  <bpmn:collaboration id="Collaboration_VentaConsultiva">
    <bpmn:documentation>Proceso: Nuevos clientes con instalación de alarmas y/o cámaras. Subproceso: Venta consultiva (etapas 1 a 5, Ventas), desde el primer contacto hasta la confirmación del cliente. Es el proceso llamado por la actividad "Venta consultiva (etapas 1 a 5)" del diagrama "Confirmación de la venta y cobro". Borrador v0.1 — 14/10/2026 — basado en el documento "Proceso de venta y atención por áreas". Continúa en "Confirmación de la venta y cobro" (etapa 6).</bpmn:documentation>
    <bpmn:participant id="Participant_Cliente" name="Prospecto / cliente" />
    <bpmn:participant id="Participant_SP" name="SP Seguridad Privada" processRef="Process_VentaConsultiva" />
    <bpmn:messageFlow id="MF1" name="Consulta" sourceRef="Participant_Cliente" targetRef="Start_Consulta" />
    <bpmn:messageFlow id="MF5" name="Contacto directo" sourceRef="Participant_Cliente" targetRef="Start_ContactoDirecto" />
    <bpmn:messageFlow id="MF2" name="Día y horario de la visita" sourceRef="Task_AgendarVisita" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MF3" name="Presupuesto" sourceRef="Task_Presupuesto" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MF4" name="Seguimiento" sourceRef="Task_Seguimiento" targetRef="Participant_Cliente" />
  </bpmn:collaboration>
  <bpmn:process id="Process_VentaConsultiva" name="Nuevos clientes – Venta consultiva (etapas 1 a 5)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SP">
      <bpmn:lane id="Lane_Ventas" name="Ventas"><bpmn:flowNodeRef>Start_ContactoDirecto</bpmn:flowNodeRef><bpmn:flowNodeRef>Start_Consulta</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_BotResponde</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_BotReleva</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Derivar</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ConsultaBot</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AtenderDerivada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Calificar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Calificado</bpmn:flowNodeRef><bpmn:flowNodeRef>End_LeadDescartado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AgendarVisita</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmarCita</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Visita</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarRelevamiento</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Presupuesto</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Seguimiento</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Acepta</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ClienteConfirma</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_PideAjuste</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AjustarPresupuesto</bpmn:flowNodeRef><bpmn:flowNodeRef>End_OportunidadPerdida</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="LaneSet_Ventas">
          <bpmn:lane id="Lane_BotIA" name="Bot IA comercial (GHL)"><bpmn:flowNodeRef>Start_Consulta</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_BotResponde</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_BotReleva</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Derivar</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ConsultaBot</bpmn:flowNodeRef></bpmn:lane>
          <bpmn:lane id="Lane_AgenteComercial" name="Agente comercial"><bpmn:flowNodeRef>Start_ContactoDirecto</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AtenderDerivada</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Calificar</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Calificado</bpmn:flowNodeRef><bpmn:flowNodeRef>End_LeadDescartado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AgendarVisita</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmarCita</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Visita</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarRelevamiento</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Presupuesto</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Seguimiento</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Acepta</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ClienteConfirma</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_PideAjuste</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AjustarPresupuesto</bpmn:flowNodeRef><bpmn:flowNodeRef>End_OportunidadPerdida</bpmn:flowNodeRef></bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Consulta" name="Consulta del prospecto (redes o WhatsApp)"><bpmn:outgoing>F1</bpmn:outgoing><bpmn:messageEventDefinition id="Start_Consulta_Def" /></bpmn:startEvent>
    <bpmn:task id="Task_BotResponde" name="Responder preguntas frecuentes"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_BotReleva" name="Relevar datos básicos del prospecto"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Derivar" name="¿Excede al bot o hay intención de avanzar?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ConsultaBot" name="Consulta atendida por el bot"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_AtenderDerivada" name="Atender la consulta derivada por el bot"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Calificar" name="Calificar al prospecto y registrar el lead"><bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Calificado" name="¿Calificado y en zona de cobertura?"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing><bpmn:outgoing>F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_LeadDescartado" name="Lead descartado"><bpmn:incoming>F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_AgendarVisita" name="Coordinar y agendar la visita (etapa 2)"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
    <bpmn:sendTask id="Task_ConfirmarCita" name="Confirmar la cita y enviar recordatorio"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:sendTask>
    <bpmn:task id="Task_Visita" name="Realizar la visita: relevamiento y propuesta de valor (etapa 3)"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_RegistrarRelevamiento" name="Registrar el relevamiento en el sistema"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
    <bpmn:sendTask id="Task_Presupuesto" name="Elaborar y enviar el presupuesto (etapa 4)"><bpmn:incoming>F13</bpmn:incoming><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:sendTask>
    <bpmn:task id="Task_Seguimiento" name="Seguimiento del presupuesto (etapa 5)"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Acepta" name="¿El cliente acepta el presupuesto?"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ClienteConfirma" name="El cliente confirma la venta"><bpmn:incoming>F16</bpmn:incoming><bpmn:messageEventDefinition id="End_ClienteConfirma_Def" /></bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_PideAjuste" name="¿Pide un ajuste?"><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing><bpmn:outgoing>F19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_AjustarPresupuesto" name="Ajustar el presupuesto (equipo, plan o condiciones)"><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_OportunidadPerdida" name="Oportunidad perdida (rechazo o vencimiento)"><bpmn:incoming>F19</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Consulta" targetRef="Task_BotResponde" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_BotResponde" targetRef="Task_BotReleva" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_BotReleva" targetRef="Gw_Derivar" />
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="Gw_Derivar" targetRef="End_ConsultaBot" />
    <bpmn:sequenceFlow id="F5" name="Sí: deriva a un agente" sourceRef="Gw_Derivar" targetRef="Task_AtenderDerivada" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_AtenderDerivada" targetRef="Task_Calificar" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Calificar" targetRef="Gw_Calificado" />
    <bpmn:sequenceFlow id="F8" name="No" sourceRef="Gw_Calificado" targetRef="End_LeadDescartado" />
    <bpmn:sequenceFlow id="F9" name="Sí" sourceRef="Gw_Calificado" targetRef="Task_AgendarVisita" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_AgendarVisita" targetRef="Task_ConfirmarCita" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_ConfirmarCita" targetRef="Task_Visita" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Visita" targetRef="Task_RegistrarRelevamiento" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_RegistrarRelevamiento" targetRef="Task_Presupuesto" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Presupuesto" targetRef="Task_Seguimiento" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Seguimiento" targetRef="Gw_Acepta" />
    <bpmn:sequenceFlow id="F16" name="Sí" sourceRef="Gw_Acepta" targetRef="End_ClienteConfirma" />
    <bpmn:sequenceFlow id="F17" name="No" sourceRef="Gw_Acepta" targetRef="Gw_PideAjuste" />
    <bpmn:sequenceFlow id="F18" name="Sí" sourceRef="Gw_PideAjuste" targetRef="Task_AjustarPresupuesto" />
    <bpmn:sequenceFlow id="F19" name="No" sourceRef="Gw_PideAjuste" targetRef="End_OportunidadPerdida" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_AjustarPresupuesto" targetRef="Task_Presupuesto" />
    <bpmn:textAnnotation id="Ann_Oportunidad"><bpmn:text>A definir: en qué momento el agente IA crea la oportunidad en GHL (hoy solo deriva la conversación a un humano)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Ann_Oportunidad_Assoc" sourceRef="Ann_Oportunidad" targetRef="Gw_Derivar" />
    <bpmn:textAnnotation id="Ann_PlazoContacto"><bpmn:text>A definir: plazo para contactar al lead desde su calificación</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Ann_PlazoContacto_Assoc" sourceRef="Ann_PlazoContacto" targetRef="Task_AgendarVisita" />
    <bpmn:textAnnotation id="Ann_Cadencia"><bpmn:text>Cadencia sugerida: 24-48 hs y luego semanal. Puede intervenir el bot</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Ann_Cadencia_Assoc" sourceRef="Ann_Cadencia" targetRef="Task_Seguimiento" />
    <bpmn:textAnnotation id="Ann_Continua"><bpmn:text>Vuelve al diagrama "Confirmación de la venta y cobro": etapa 6, formalización y traspaso a Atención al Cliente</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Ann_Continua_Assoc" sourceRef="Ann_Continua" targetRef="End_ClienteConfirma" />
    <bpmn:group id="Grp_E1" categoryValueRef="CV_Grp_E1" />
    <bpmn:group id="Grp_E2" categoryValueRef="CV_Grp_E2" />
    <bpmn:group id="Grp_E3" categoryValueRef="CV_Grp_E3" />
    <bpmn:group id="Grp_E4" categoryValueRef="CV_Grp_E4" />
    <bpmn:group id="Grp_E5" categoryValueRef="CV_Grp_E5" />
    <bpmn:startEvent id="Start_ContactoDirecto" name="Contacto directo al vendedor (teléfono, WhatsApp o correo)"><bpmn:outgoing>F21</bpmn:outgoing><bpmn:messageEventDefinition id="Start_ContactoDirecto_Def" /></bpmn:startEvent>
    <bpmn:sequenceFlow id="F21" sourceRef="Start_ContactoDirecto" targetRef="Task_Calificar" />
    <bpmn:textAnnotation id="Ann_RegistroLead"><bpmn:text>Contacto fuera del bot: el vendedor carga el lead en GHL para que quede registrado y entre en el seguimiento</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Ann_RegistroLead_Assoc" sourceRef="Ann_RegistroLead" targetRef="Start_ContactoDirecto" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_VentaConsultiva">
    <bpmndi:BPMNPlane id="BPMNPlane_VentaConsultiva" bpmnElement="Collaboration_VentaConsultiva">
      <bpmndi:BPMNShape id="Participant_Cliente_di" bpmnElement="Participant_Cliente" isHorizontal="true"><dc:Bounds x="160" y="40" width="2610" height="80" /></bpmndi:BPMNShape>
