<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_NuevosClientesVentaCobro" targetNamespace="http://sp-seguridad.com/procesos" exporter="bpmn-js" exporterVersion="18.30.1">
  <bpmn:collaboration id="Collaboration_VentaCobro">
    <bpmn:documentation>Proceso: Nuevos clientes con instalación de alarmas y/o cámaras. Subproceso: Confirmación de la venta y cobro (Ventas → Atención al Cliente). Borrador v0.1 — 30/09/2026 — surge de la reunión R2. Hitos 1 y 2 de la matriz de responsabilidades.</bpmn:documentation>
    <bpmn:participant id="Participant_Cliente" name="Cliente" />
    <bpmn:participant id="Participant_SP" name="SP Seguridad Privada" processRef="Process_VentaCobro" />
    <bpmn:messageFlow id="MF1" name="Próximos pasos y contacto de Atención al Cliente" sourceRef="Task_InformarPasos" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MF2" name="Contacto del vendedor" sourceRef="Task_VendedorRetoma" targetRef="Participant_Cliente" />
  </bpmn:collaboration>
  <bpmn:process id="Process_VentaCobro" name="Nuevos clientes – Confirmación de la venta y cobro" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Ventas" name="Ventas"><bpmn:flowNodeRef>Start_Oportunidad</bpmn:flowNodeRef><bpmn:flowNodeRef>Sub_VentaConsultiva</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Confirma</bpmn:flowNodeRef><bpmn:flowNodeRef>End_OportunidadPerdida</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Formalizar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_InformarPasos</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Derivar</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ActualizarPresupuesto</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_VendedorRetoma</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_ClienteConfirmaPago</bpmn:flowNodeRef><bpmn:flowNodeRef>End_VentaPerdida</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_AtencionCliente" name="Atención al Cliente"><bpmn:flowNodeRef>Task_RecibirTraspaso</bpmn:flowNodeRef><bpmn:flowNodeRef>Sub_GestionCobro</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_ResultadoCobro</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RegistrarCobro</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_GenerarCaso</bpmn:flowNodeRef><bpmn:flowNodeRef>End_CasoGenerado</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AvisoVencimiento</bpmn:flowNodeRef><bpmn:flowNodeRef>End_AvisoEnviado</bpmn:flowNodeRef><bpmn:flowNodeRef>Bnd_AvisoVencimiento</bpmn:flowNodeRef><bpmn:flowNodeRef>Bnd_PresupuestoVencido</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Start_Oportunidad" name="Oportunidad calificada"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:subProcess id="Sub_VentaConsultiva" name="Venta consultiva (etapas 1 a 5)"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:subProcess>
      <bpmn:exclusiveGateway id="Gw_Confirma" name="¿El cliente confirma la venta?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_OportunidadPerdida" name="Oportunidad perdida"><bpmn:incoming>F3</bpmn:incoming></bpmn:endEvent>
      <bpmn:task id="Task_Formalizar" name="Formalizar la venta (etapa 6)"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
      <bpmn:sendTask id="Task_InformarPasos" name="Informar próximos pasos y presentar a Atención al Cliente"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:sendTask>
      <bpmn:task id="Task_Derivar" name="Derivar el caso a Atención al Cliente"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_ActualizarPresupuesto" name="Actualizar el presupuesto"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_VendedorRetoma" name="Vendedor retoma el contacto con el cliente"><bpmn:incoming>F13</bpmn:incoming><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gw_ClienteConfirmaPago" name="¿El cliente confirma que va a pagar?"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_VentaPerdida" name="Venta perdida"><bpmn:incoming>F15</bpmn:incoming></bpmn:endEvent>
      <bpmn:task id="Task_RecibirTraspaso" name="Recibir y validar los datos del traspaso"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
      <bpmn:subProcess id="Sub_GestionCobro" name="Gestión del cobro"><bpmn:incoming>F8</bpmn:incoming><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing>
        <bpmn:startEvent id="Start_TraspasoRecibido" name="Traspaso recibido"><bpmn:outgoing>SF1</bpmn:outgoing></bpmn:startEvent>
        <bpmn:sendTask id="Task_MensajePresentacion" name="Enviar mensaje de presentación y seguimiento (automático GHL)"><bpmn:incoming>SF1</bpmn:incoming><bpmn:outgoing>SF2</bpmn:outgoing></bpmn:sendTask>
        <bpmn:task id="Task_ContactarCliente" name="Contactar al cliente para gestionar el pago"><bpmn:incoming>SF2</bpmn:incoming><bpmn:incoming>SF9</bpmn:incoming><bpmn:outgoing>SF3</bpmn:outgoing></bpmn:task>
        <bpmn:exclusiveGateway id="Gw_Responde" name="¿El cliente responde?"><bpmn:incoming>SF3</bpmn:incoming><bpmn:outgoing>SF4</bpmn:outgoing><bpmn:outgoing>SF7</bpmn:outgoing></bpmn:exclusiveGateway>
        <bpmn:task id="Task_AcordarPago" name="Acordar el medio de pago (efectivo en sede o transferencia)"><bpmn:incoming>SF4</bpmn:incoming><bpmn:outgoing>SF5</bpmn:outgoing></bpmn:task>
        <bpmn:intermediateCatchEvent id="Evt_PagoRecibido" name="Pago recibido"><bpmn:incoming>SF5</bpmn:incoming><bpmn:outgoing>SF6</bpmn:outgoing><bpmn:messageEventDefinition id="Evt_PagoRecibido_Def" /></bpmn:intermediateCatchEvent>
        <bpmn:endEvent id="End_CobroConcretado" name="Cobro concretado"><bpmn:incoming>SF6</bpmn:incoming></bpmn:endEvent>
        <bpmn:exclusiveGateway id="Gw_QuedanIntentos" name="¿Quedan intentos?"><bpmn:incoming>SF7</bpmn:incoming><bpmn:outgoing>SF8</bpmn:outgoing><bpmn:outgoing>SF10</bpmn:outgoing></bpmn:exclusiveGateway>
        <bpmn:intermediateCatchEvent id="Evt_EsperarIntento" name="Esperar el próximo intento"><bpmn:incoming>SF8</bpmn:incoming><bpmn:outgoing>SF9</bpmn:outgoing><bpmn:timerEventDefinition id="Evt_EsperarIntento_Def" /></bpmn:intermediateCatchEvent>
        <bpmn:endEvent id="End_SinRespuesta" name="Sin respuesta del cliente"><bpmn:incoming>SF10</bpmn:incoming></bpmn:endEvent>
        <bpmn:sequenceFlow id="SF1" sourceRef="Start_TraspasoRecibido" targetRef="Task_MensajePresentacion" />
        <bpmn:sequenceFlow id="SF2" sourceRef="Task_MensajePresentacion" targetRef="Task_ContactarCliente" />
        <bpmn:sequenceFlow id="SF3" sourceRef="Task_ContactarCliente" targetRef="Gw_Responde" />
        <bpmn:sequenceFlow id="SF4" name="Sí" sourceRef="Gw_Responde" targetRef="Task_AcordarPago" />
        <bpmn:sequenceFlow id="SF5" sourceRef="Task_AcordarPago" targetRef="Evt_PagoRecibido" />
        <bpmn:sequenceFlow id="SF6" sourceRef="Evt_PagoRecibido" targetRef="End_CobroConcretado" />
        <bpmn:sequenceFlow id="SF7" name="No" sourceRef="Gw_Responde" targetRef="Gw_QuedanIntentos" />
        <bpmn:sequenceFlow id="SF8" name="Sí" sourceRef="Gw_QuedanIntentos" targetRef="Evt_EsperarIntento" />
        <bpmn:sequenceFlow id="SF9" sourceRef="Evt_EsperarIntento" targetRef="Task_ContactarCliente" />
        <bpmn:sequenceFlow id="SF10" name="No" sourceRef="Gw_QuedanIntentos" targetRef="End_SinRespuesta" />
        <bpmn:textAnnotation id="Ann_Intentos"><bpmn:text>A definir (R2): cantidad de intentos, medios (llamada, WhatsApp, email) y plazo antes de devolver el caso al vendedor</bpmn:text></bpmn:textAnnotation>
        <bpmn:textAnnotation id="Ann_GHL"><bpmn:text>Propuesta (R2): formalizar el seguimiento con mensajes automáticos desde GHL</bpmn:text></bpmn:textAnnotation>
        <bpmn:association id="Ann_Intentos_Assoc" sourceRef="Ann_Intentos" targetRef="Gw_QuedanIntentos" />
        <bpmn:association id="Ann_GHL_Assoc" sourceRef="Ann_GHL" targetRef="Task_MensajePresentacion" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="Gw_ResultadoCobro" name="¿Se concretó el cobro?"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:task id="Task_RegistrarCobro" name="Registrar el cobro del 100% en NetSuite"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
      <bpmn:serviceTask id="Task_GenerarCaso" name="Generar el caso de instalación (automático NetSuite)"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="End_CasoGenerado" name="Caso de instalación generado (hito 2)"><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent>
      <bpmn:sendTask id="Task_AvisoVencimiento" name="Enviar aviso de vencimiento del presupuesto"><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="End_AvisoEnviado" name="Aviso enviado"><bpmn:incoming>F18</bpmn:incoming></bpmn:endEvent>
      <bpmn:boundaryEvent id="Bnd_AvisoVencimiento" name="X días antes del vencimiento del presupuesto" attachedToRef="Sub_GestionCobro" cancelActivity="false"><bpmn:outgoing>F17</bpmn:outgoing><bpmn:timerEventDefinition id="Bnd_AvisoVencimiento_Def" /></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Bnd_PresupuestoVencido" name="Presupuesto vencido sin cobro" attachedToRef="Sub_GestionCobro"><bpmn:outgoing>F19</bpmn:outgoing><bpmn:timerEventDefinition id="Bnd_PresupuestoVencido_Def" /></bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="F1" sourceRef="Start_Oportunidad" targetRef="Sub_VentaConsultiva" />
      <bpmn:sequenceFlow id="F2" sourceRef="Sub_VentaConsultiva" targetRef="Gw_Confirma" />
      <bpmn:sequenceFlow id="F3" name="No" sourceRef="Gw_Confirma" targetRef="End_OportunidadPerdida" />
      <bpmn:sequenceFlow id="F4" name="Sí" sourceRef="Gw_Confirma" targetRef="Task_Formalizar" />
      <bpmn:sequenceFlow id="F5" sourceRef="Task_Formalizar" targetRef="Task_InformarPasos" />
      <bpmn:sequenceFlow id="F6" sourceRef="Task_InformarPasos" targetRef="Task_Derivar" />
      <bpmn:sequenceFlow id="F7" sourceRef="Task_Derivar" targetRef="Task_RecibirTraspaso" />
      <bpmn:sequenceFlow id="F8" sourceRef="Task_RecibirTraspaso" targetRef="Sub_GestionCobro" />
      <bpmn:sequenceFlow id="F9" sourceRef="Sub_GestionCobro" targetRef="Gw_ResultadoCobro" />
      <bpmn:sequenceFlow id="F10" name="Cobro concretado" sourceRef="Gw_ResultadoCobro" targetRef="Task_RegistrarCobro" />
      <bpmn:sequenceFlow id="F11" sourceRef="Task_RegistrarCobro" targetRef="Task_GenerarCaso" />
      <bpmn:sequenceFlow id="F12" sourceRef="Task_GenerarCaso" targetRef="End_CasoGenerado" />
      <bpmn:sequenceFlow id="F13" name="Sin respuesta del cliente" sourceRef="Gw_ResultadoCobro" targetRef="Task_VendedorRetoma" />
      <bpmn:sequenceFlow id="F14" sourceRef="Task_VendedorRetoma" targetRef="Gw_ClienteConfirmaPago" />
      <bpmn:sequenceFlow id="F15" name="No" sourceRef="Gw_ClienteConfirmaPago" targetRef="End_VentaPerdida" />
      <bpmn:sequenceFlow id="F16" name="Sí" sourceRef="Gw_ClienteConfirmaPago" targetRef="Sub_GestionCobro" />
      <bpmn:sequenceFlow id="F17" sourceRef="Bnd_AvisoVencimiento" targetRef="Task_AvisoVencimiento" />
      <bpmn:sequenceFlow id="F18" sourceRef="Task_AvisoVencimiento" targetRef="End_AvisoEnviado" />
      <bpmn:sequenceFlow id="F19" sourceRef="Bnd_PresupuestoVencido" targetRef="Task_ActualizarPresupuesto" />
      <bpmn:sequenceFlow id="F20" sourceRef="Task_ActualizarPresupuesto" targetRef="Task_VendedorRetoma" />
      <bpmn:textAnnotation id="Ann_DatosTraspaso"><bpmn:text>Datos mínimos del traspaso (R2, a completar). Definido: incluye la forma de pago, para que Atención al Cliente sepa cuándo esperar el primer cobro (comodato: primer abono, 1 mes después de la instalación o al terminar el beneficio de X meses)</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Ann_DatosTraspaso_Assoc" sourceRef="Ann_DatosTraspaso" targetRef="Task_Derivar" />
      <bpmn:textAnnotation id="Ann_NumeroDesconocido"><bpmn:text>Problema (R2): el cliente no responde a un número desconocido, más aún tratándose de un pago</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Ann_NumeroDesconocido_Assoc" sourceRef="Ann_NumeroDesconocido" targetRef="Sub_GestionCobro" />
      <bpmn:textAnnotation id="Ann_Vigencia"><bpmn:text>A definir (R2): plazo de vigencia del presupuesto y anticipación del aviso</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Ann_Vigencia_Assoc" sourceRef="Ann_Vigencia" targetRef="Task_AvisoVencimiento" />
      <bpmn:textAnnotation id="Ann_VentaPerdida"><bpmn:text>A definir (R2): criterio y plazo para pasar un presupuesto no cobrado a venta perdida</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Ann_VentaPerdida_Assoc" sourceRef="Ann_VentaPerdida" targetRef="End_VentaPerdida" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Main">
    <bpmndi:BPMNPlane id="BPMNPlane_Main" bpmnElement="Collaboration_VentaCobro">
      <bpmndi:BPMNShape id="Participant_Cliente_di" bpmnElement="Participant_Cliente" isHorizontal="true"><dc:Bounds x="160" y="40" width="2225" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_SP_di" bpmnElement="Participant_SP" isHorizontal="true"><dc:Bounds x="160" y="160" width="2225" height="620" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ventas_di" bpmnElement="Lane_Ventas" isHorizontal="true"><dc:Bounds x="190" y="160" width="2195" height="310" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AtencionCliente_di" bpmnElement="Lane_AtencionCliente" isHorizontal="true"><dc:Bounds x="190" y="470" width="2195" height="310" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Oportunidad_di" bpmnElement="Start_Oportunidad"><dc:Bounds x="272" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_VentaConsultiva_di" bpmnElement="Sub_VentaConsultiva" isExpanded="false"><dc:Bounds x="415" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Confirma_di" bpmnElement="Gw_Confirma" isMarkerVisible="true"><dc:Bounds x="615" y="225" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="575" y="194" width="130" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OportunidadPerdida_di" bpmnElement="End_OportunidadPerdida"><dc:Bounds x="622" y="362" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Formalizar_di" bpmnElement="Task_Formalizar"><dc:Bounds x="765" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InformarPasos_di" bpmnElement="Task_InformarPasos"><dc:Bounds x="940" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Derivar_di" bpmnElement="Task_Derivar"><dc:Bounds x="1115" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ActualizarPresupuesto_di" bpmnElement="Task_ActualizarPresupuesto"><dc:Bounds x="1290" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VendedorRetoma_di" bpmnElement="Task_VendedorRetoma"><dc:Bounds x="1640" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_ClienteConfirmaPago_di" bpmnElement="Gw_ClienteConfirmaPago" isMarkerVisible="true"><dc:Bounds x="1840" y="355" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1795" y="324" width="140" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_VentaPerdida_di" bpmnElement="End_VentaPerdida"><dc:Bounds x="2022" y="362" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecibirTraspaso_di" bpmnElement="Task_RecibirTraspaso"><dc:Bounds x="1290" y="530" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_GestionCobro_di" bpmnElement="Sub_GestionCobro" isExpanded="false"><dc:Bounds x="1465" y="530" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_ResultadoCobro_di" bpmnElement="Gw_ResultadoCobro" isMarkerVisible="true"><dc:Bounds x="1665" y="545" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1635" y="599" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegistrarCobro_di" bpmnElement="Task_RegistrarCobro"><dc:Bounds x="1815" y="530" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerarCaso_di" bpmnElement="Task_GenerarCaso"><dc:Bounds x="1990" y="530" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CasoGenerado_di" bpmnElement="End_CasoGenerado"><dc:Bounds x="2197" y="552" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AvisoVencimiento_di" bpmnElement="Task_AvisoVencimiento"><dc:Bounds x="1465" y="660" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_AvisoEnviado_di" bpmnElement="End_AvisoEnviado"><dc:Bounds x="1672" y="682" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bnd_AvisoVencimiento_di" bpmnElement="Bnd_AvisoVencimiento"><dc:Bounds x="1512" y="592" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1552" y="618" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bnd_PresupuestoVencido_di" bpmnElement="Bnd_PresupuestoVencido"><dc:Bounds x="1472" y="512" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1360" y="482" width="105" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="308" y="250" /><di:waypoint x="415" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="515" y="250" /><di:waypoint x="615" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="640" y="275" /><di:waypoint x="640" y="362" /><bpmndi:BPMNLabel><dc:Bounds x="646" y="283" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="665" y="250" /><di:waypoint x="765" y="250" /><bpmndi:BPMNLabel><dc:Bounds x="673" y="230" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="865" y="250" /><di:waypoint x="940" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1040" y="250" /><di:waypoint x="1115" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1165" y="290" /><di:waypoint x="1165" y="570" /><di:waypoint x="1290" y="570" /></bpmndi:BPMNEdge>
